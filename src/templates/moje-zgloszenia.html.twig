{% set leftButton = 'menu' %}
{% set rightButton = 'menuStart' %}

{% set title = 'Moje zgłoszenia' %}
{% set mainClass = 'my-applications' %}

{% extends "base.html.twig" %}
{% block footer %}
<footer></footer>
{% endblock %}
{% block main %}

<h2>Przeglądaj swoje zgłoszenia</h2>
{% if countChanged > 0 %}
<p><b>(zmieniliśmy status {{ countChanged }} zgłoszeń)</b></p>
{% endif %}

{% if totalCountAll == 0 %}
    <p>Nie masz jeszcze ani jednego zgłoszenia.</p>
    <a href="/nowe-zgloszenie.html" class="button cta last">Stwórz nowe</a>
{% else %}
    <p>Wybierz zgłoszenie poniżej, żeby zobaczyć jego szczegóły, zmienić mu status lub dodać komentarz.</p>

    {% if isAdmin or 'patron' in general.stats.badges %}
    <p><a href="/zgloszenia.xlsx">Pobierz</a> wszystkie zgłoszenia w jednym pliku xls.</p>
    {% elseif totalCount > 50 %}
        <p>Dużo zgłoszeń? <a href="/patronite.html">Patroni i Patronki</a> mogą pobierać zgłoszenia w pliku xls.</p>
    {% endif %}

    {% if general.stats.confirmed ?? 0 > 0 %}
        <p>Masz <b>zgłoszenia czekające na wysłanie</b>.
        Rozwiń zgłoszenia poniżej, i wybierz duży przycisk „wyślij”.</p>
    {% endif %}


    <form autocomplete="off" method="get" action="/moje-zgloszenia.html">
        <input autocomplete="false" data-type="filterable" data-server-search="1" type="text" id="apps" name="q"
            placeholder="Numer rej. lub numer zgłoszenia" value="{{ query }}">
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="status" value="{{ currentStatus }}">
        <ul class="status-filter">
        {% for key,val in statuses %}
            {% set count = statusCounts[key] ?? 0 %}
            <li class="status {{key}}" data-count="{{ count }}" {% if count == 0 %}style="display: none;"{% endif %}>
                {% if currentStatus == key %}
                    <a href="/moje-zgloszenia.html?page=1{% if query %}&q={{ query|url_encode }}{% endif %}" id="{{ key }}" class="active">{{ val.name|upper }}</a>
                {% else %}
                    <a href="/moje-zgloszenia.html?page=1&status={{ key }}{% if query %}&q={{ query|url_encode }}{% endif %}" id="{{ key }}">{{ val.name|upper }}</a>
                {% endif %}
                <span class="li-count" data-count="{{ count }}">{{ count }}</span>
            </li>
        {% endfor %}
        </ul>
    </form>
    
    <dialog data-role="popup" id="patronite">
        <p><b>Cieszę się, że zmieniłeś na lepsze swoje otoczenie!</b></p>
        <p>Chciałbym poświęcić więcej czasu swojej misji odzyskania przestrzeni dla pieszych.
            Twoje wsparcie dla serwisu Uprzejmie Donoszę może mi w tym bardzo pomóc.</p>
            <a class="button patronite small"
                href="/patronite.html">Zostań Patronem</a>
        </p>
    </dialog>


    <div id="recydywa" class="popup-overlay">
        <div class="ui-content popup-content">
        </div>
    </div>

    <div data-role="collapsibleset" data-iconpos="right" data-filter="true" id="apps-list">
        {% if totalCount == 0 %}
            <p class="empty-filtered">
                Nie znaleziono zgłoszeń spełniających kryteria wyszukiwania.
                <a href="/moje-zgloszenia.html">Pokaż wszystkie</a>
            </p>
        {% else %}
            {% for app in applications %}
                {% include('_application-short.html.twig') %}
            {% endfor %}
        {% endif %}
    </div>
    {% if totalPages > 1 %}
    <div class="pagination">
        {% set statusParam = currentStatus != 'all' ? '&status=' ~ currentStatus : '' %}
        {% set queryParam = query ? '&q=' ~ query|url_encode : '' %}
        {% set window = 2 %}
        {% set start = currentPage - window %}
        {% set end = currentPage + window %}
        {% if start < 1 %}{% set start = 1 %}{% endif %}
        {% if end > totalPages %}{% set end = totalPages %}{% endif %}
        {% if currentPage > 1 %}
            <a class="button light page page-nav prev" href="/moje-zgloszenia.html?page={{ currentPage - 1 }}{{ statusParam }}{{ queryParam }}">Poprzednia</a>
        {% endif %}
        {% if totalPages >= 1 %}
            {% if currentPage == 1 %}
                <span class="page current num">1</span>
            {% else %}
                <a class="button light page num" href="/moje-zgloszenia.html?page=1{{ statusParam }}{{ queryParam }}">1</a>
            {% endif %}
        {% endif %}
        {% if start > 2 %}
            <span class="page ellipsis">…</span>
        {% endif %}
        {% for p in start..end %}
            {% if p > 1 and p < totalPages %}
                {% if p == currentPage %}
                    <span class="page current num">{{ p }}</span>
                {% else %}
                    <a class="button light page num" href="/moje-zgloszenia.html?page={{ p }}{{ statusParam }}{{ queryParam }}">{{ p }}</a>
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if end < totalPages - 1 %}
            <span class="page ellipsis">…</span>
        {% endif %}
        {% if totalPages > 1 %}
            {% if currentPage == totalPages %}
                <span class="page current num">{{ totalPages }}</span>
            {% else %}
                <a class="button light page num" href="/moje-zgloszenia.html?page={{ totalPages }}{{ statusParam }}{{ queryParam }}">{{ totalPages }}</a>
            {% endif %}
        {% endif %}
        {% if currentPage < totalPages %}
            <a class="button light page page-nav next" href="/moje-zgloszenia.html?page={{ currentPage + 1 }}{{ statusParam }}{{ queryParam }}">Następna</a>
        {% endif %}
    </div>
    {% endif %}
{% endif %}
{% endblock %}
